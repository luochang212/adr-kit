---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const features = [1, 2, 3, 4] as const;
---

<section class="section features" id="features">
  <div class="section__inner">
    <div class="reveal">
      <p class="section__eyebrow">{t('features.eyebrow')}</p>
      <h2 class="section__title">{t('features.title')}</h2>
    </div>
    <div class="features__grid reveal">
      {features.map((n) => (
        <article class="features__card">
          <h3>{t(`features.${n}.title` as const)}</h3>
          <p>{t(`features.${n}.body` as const)}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features { border-top: 1px solid var(--border); }
  .features__grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }
  .features__card {
    background: var(--bg);
    padding: 30px 28px;
    transition: background-color 0.2s;
  }
  .features__card:hover { background: var(--surface); }
  .features__card h3 {
    font-size: 17px;
    font-weight: 650;
    letter-spacing: -0.01em;
    margin: 0 0 10px;
  }
  .features__card p {
    margin: 0;
    font-size: 14px;
    color: var(--fg-50);
  }
  @media (max-width: 720px) {
    .features__grid { grid-template-columns: 1fr; }
  }
</style>
