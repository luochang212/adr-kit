---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const states = [
  { key: 'draft', mono: 'adr/.drafts/', cls: 'draft' },
  { key: 'accepted', mono: 'decisions/N-*.md', cls: 'accepted' },
  { key: 'superseded', mono: 'superseded-by: N', cls: 'superseded' },
  { key: 'rejected', mono: 'Alternatives considered', cls: 'rejected' },
] as const;
---

<section class="section lifecycle" id="lifecycle">
  <div class="section__inner">
    <div class="reveal">
      <p class="section__eyebrow">{t('lifecycle.eyebrow')}</p>
      <h2 class="section__title">{t('lifecycle.title')}</h2>
      <p class="section__lead">{t('lifecycle.lead')}</p>
    </div>
    <div class="lifecycle__grid reveal">
      {states.map((s, i) => (
        <>
          {i > 0 && i !== 3 && <span class="lifecycle__arrow" aria-hidden="true">→</span>}
          {i === 3 && <span class="lifecycle__arrow lifecycle__arrow--branch" aria-hidden="true">↘</span>}
          <article class={`lifecycle__card lifecycle__card--${s.cls}`}>
            <header class="lifecycle__head">
              <span class={`lifecycle__dot lifecycle__dot--${s.cls}`}></span>
              <h3>{s.key}</h3>
            </header>
            <p class="lifecycle__body">{t(`lifecycle.${s.key}` as const)}</p>
            <code class="lifecycle__mono">{s.mono}</code>
          </article>
        </>
      ))}
    </div>
  </div>
</section>

<style>

  .lifecycle__grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }
  .lifecycle__card {
    background: var(--bg);
    padding: 24px 22px 20px;
    transition: background-color 0.2s;
  }
  .lifecycle__card:hover { background: var(--surface); }
  .lifecycle__head {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .lifecycle__head h3 {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .lifecycle__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }
  .lifecycle__dot--draft { background: var(--fg-30); }
  .lifecycle__dot--accepted { background: var(--cyan); }
  .lifecycle__dot--rejected { background: var(--fg-30); }
  .lifecycle__dot--superseded { background: var(--indigo); }
  .lifecycle__body {
    margin: 12px 0 16px;
    font-size: 13.5px;
    color: var(--fg-50);
    min-height: 88px;
  }
  .lifecycle__mono {
    font-size: 11.5px;
    color: var(--fg-30);
  }
  .lifecycle__arrow { display: none; }
  @media (max-width: 960px) {
    .lifecycle__grid { grid-template-columns: repeat(2, 1fr); }
    .lifecycle__body { min-height: 0; }
  }
  @media (max-width: 560px) {
    .lifecycle__grid { grid-template-columns: 1fr; }
  }
</style>
