---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const states = [
  { key: 'proposed', mono: 'adr/proposed/', cls: 'proposed' },
  { key: 'implemented', mono: 'adr/implemented/N-*.md', cls: 'implemented' },
  { key: 'rejected', mono: 'adr/rejected/', cls: 'rejected' },
  { key: 'archived', mono: 'adr/archived/N-*.md', cls: 'archived' },
] as const;
---

<section class="section lifecycle" id="lifecycle">
  <div class="section__inner">
    <div class="reveal">
      <p class="section__eyebrow">{t('lifecycle.eyebrow')}</p>
      <h2 class="section__title">{t('lifecycle.title')}</h2>
      <p class="section__lead">{t('lifecycle.lead')}</p>
    </div>
    <div class="lifecycle__grid reveal">
      {states.map((state) => (
        <article class={`lifecycle__card lifecycle__card--${state.cls}`}>
          <header class="lifecycle__head">
            <span class={`lifecycle__dot lifecycle__dot--${state.cls}`}></span>
            <h3>{state.key}</h3>
          </header>
          <p class="lifecycle__body">{t(`lifecycle.${state.key}` as const)}</p>
          <code class="lifecycle__mono">{state.mono}</code>
        </article>
      ))}
    </div>
  </div>
</section>

<style>

  .lifecycle__grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }
  .lifecycle__card {
    background: var(--bg);
    padding: 24px 22px 20px;
    transition: background-color 0.2s;
  }
  .lifecycle__card:hover { background: var(--surface); }
  .lifecycle__head {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .lifecycle__head h3 {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }
  .lifecycle__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }
  .lifecycle__dot--proposed { background: var(--fg-30); }
  .lifecycle__dot--implemented { background: var(--cyan); }
  .lifecycle__dot--rejected { background: var(--fg-30); }
  .lifecycle__dot--archived { background: var(--indigo); }
  .lifecycle__body {
    margin: 12px 0 16px;
    font-size: 13.5px;
    color: var(--fg-50);
    min-height: 88px;
  }
  .lifecycle__mono {
    font-size: 11.5px;
    color: var(--fg-30);
  }
  @media (max-width: 960px) {
    .lifecycle__grid { grid-template-columns: repeat(2, 1fr); }
    .lifecycle__body { min-height: 0; }
  }
  @media (max-width: 560px) {
    .lifecycle__grid { grid-template-columns: 1fr; }
  }
</style>
