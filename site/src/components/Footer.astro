---
import { useTranslations, langPath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__row">
      <div>
        <p class="footer__brand">ADR Kit</p>
        <p class="footer__tagline">{t('footer.tagline')}</p>
      </div>
      <nav class="footer__links">
        <a href="https://github.com/luochang212/adr-kit">GitHub</a>
        <a href="https://www.npmjs.com/package/adr-kit">npm</a>
        <a href="https://zread.ai/luochang212/adr-kit">{t('footer.docs')}</a>
        <a href="https://github.com/luochang212/adr-kit/blob/main/CHANGELOG.md">Changelog</a>
        <a href="https://github.com/luochang212/adr-kit/blob/main/LICENSE">{t('footer.license')}</a>
      </nav>
    </div>
    <p class="footer__copy">© {year} luochang212</p>
    <p class="footer__ghost" aria-hidden="true">ADR KIT</p>
  </div>
</footer>

<style>
  .footer { overflow: hidden; }
  .footer__inner {
    max-width: var(--inner);
    margin: 0 auto;
    padding: 56px 24px 0;
    position: relative;
  }
  .footer__row {
    display: flex;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
  }
  .footer__brand {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--fg);
    margin: 0 0 6px;
  }
  .footer__tagline { margin: 0; color: var(--fg-30); font-size: 13.5px; max-width: 40ch; }
  .footer__links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: flex-start;
    font-size: 13.5px;
  }
  .footer__links a { color: var(--fg-50); }
  .footer__links a:hover { color: var(--fg); }
  .footer__ghost {
    font-family: var(--font-mono);
    font-weight: 800;
    font-size: clamp(120px, 24vw, 340px);
    line-height: 1;
    height: 0.77em; /* clip plane: baseline sits ~0.86em into the line box, so this leaves ~10% cropped off the cap bottoms; rev 5 — pulled back 5% from rev 4's 0.82em */
    overflow: hidden;
    letter-spacing: -0.05em;
    margin: 64px 0 0;
    width: 100vw;
    margin-left: calc(50% - 50vw); /* full-bleed box spanning the viewport… */
    /* flex, not text-align: an overflowing nowrap line falls back to
       start-alignment under text-align (CSS2.1 §16.2); flex centers it
       with equal bleed off both edges */
    display: flex;
    justify-content: center;
    color: var(--border);
    user-select: none;
    white-space: nowrap;
  }
  .footer__copy { color: var(--fg-30); font-size: 12.5px; margin: 48px 0 0; }
</style>
