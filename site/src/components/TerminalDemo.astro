---
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;

// The transcript mirrors real CLI output, verified line-by-line against
// the shipped CLI. A proposal is scripted as filled before implementation.
const fillNote = lang === 'zh' ? '# 填满必填章节之后' : '# after filling the required sections';
// example date for the proposal filename; static on purpose (this is a scripted
// demo, not a live capture — the date is decorative)
const demoDate = '2026-09-03';

type Line = { kind: 'cmd' | 'out' | 'ok' | 'note'; text: string };
const lines: Line[] = [
  { kind: 'cmd', text: 'adrkit record "Use SQLite for session storage" --raised-by human --decided-by human' },
  { kind: 'ok', text: 'created adr/implemented/1-use-sqlite-for-session-storage.md' },
  { kind: 'out', text: '' },
  { kind: 'out', text: 'fill in the shipped decision and validate it with:' },
  { kind: 'out', text: '  adrkit validate 1' },
  { kind: 'out', text: '' },
  { kind: 'out', text: 'tip: a record governing specific files can declare optional "paths: [src/**]" in the' },
  { kind: 'out', text: '  front matter; "adrkit relevant <path>" retrieves scoped records' },
  { kind: 'cmd', text: 'adrkit propose "Use Redis for session storage"' },
  { kind: 'out', text: `created adr/proposed/${demoDate}-use-redis-for-session-storage.md` },
  { kind: 'out', text: '' },
  { kind: 'out', text: 'When the work ships, record its outcome with' },
  { kind: 'out', text: '  adrkit implement "Use Redis for session storage" --raised-by human --decided-by human' },
  { kind: 'out', text: 'or reject the proposal with' },
  { kind: 'out', text: '  adrkit reject "Use Redis for session storage" --reason "<why>"' },
  { kind: 'out', text: '' },
  { kind: 'out', text: 'tip: a record governing specific files can declare optional "paths: [src/**]" in the' },
  { kind: 'out', text: '  front matter; "adrkit relevant <path>" retrieves scoped records' },
  { kind: 'note', text: fillNote },
  { kind: 'cmd', text: 'adrkit implement "Use Redis for session storage" --raised-by human --decided-by human' },
  { kind: 'ok', text: `implemented adr/proposed/${demoDate}-use-redis-for-session-storage.md as adr/implemented/2-use-redis-for-session-storage.md` },
];
const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const transcriptHtml = lines
  .map((l) => {
    const inner = l.kind === 'cmd' ? `<span class="term__prompt">› </span>${esc(l.text)}` : esc(l.text);
    return `<span class="term__line term__line--${l.kind}">${inner}\n</span>`;
  })
  .join('');
---

<div class="term" id="term-demo">
  <div class="term__bar" aria-hidden="true">
    <span class="term__dot"></span><span class="term__dot"></span><span class="term__dot"></span>
    <span class="term__title">terminal</span>
  </div>
  <pre class="term__body" aria-label="adrkit demo transcript"><code set:html={transcriptHtml}></code></pre>
  <script type="application/json" id="term-data" set:html={JSON.stringify(lines)}></script>
</div>

<style>
  .term {
    margin: 48px auto 0;
    max-width: 760px;
    text-align: left;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #0a0e14;
    overflow: hidden;
  }
  .term__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }
  .term__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .term__title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-30);
    letter-spacing: 0.08em;
  }
  /* selection-lock-demo: 演出容器锁选区，pre 解锁保留复制能力 */
  .term { user-select: none; -webkit-user-select: none; }
  .term__body {
    margin: 0;
    padding: 20px 22px;
    font-size: 13px;
    line-height: 1.75;
    white-space: pre-wrap;
    word-break: break-word;
    user-select: text;
    -webkit-user-select: text;
  }
  .term__line { display: inline; }
  .term__line--cmd { color: var(--fg); font-weight: 500; }
  .term__line--out { color: var(--fg-50); }
  .term__line--ok { color: var(--cyan); }
  .term__line--note { color: var(--fg-30); font-style: italic; }
  .term__prompt { color: var(--cyan); }
  .term__caret::after {
    content: "▋";
    color: var(--cyan);
    animation: term-blink 1s step-end infinite;
  }
  @keyframes term-blink { 50% { opacity: 0; } }
  /* The terminal does NOT use the shared .reveal class: the generic observer
     would fade it in while the hero is still on screen. It owns its reveal
     and its script decides when .in lands — after the scroll gate, or
     immediately when the first screen is exposed enough that hiding would
     read as a hole. No-JS visitors keep the fully rendered transcript (the
     .js class gates these hidden initial states). */
  html.js .term {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  html.js .term.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html.js .term { opacity: 1; transform: none; transition: none; }
  }
  @media (max-width: 640px) {
    .term__body { font-size: 11.5px; }
  }
</style>

<script is:inline>
  // The one attention-grabbing motion on the page: the terminal plays the
  // real adrkit workflow when it scrolls into view. SSR renders the full
  // transcript, so no-JS / reduced-motion users see everything; JS clears
  // and replays it with typing.
  (function () {
    var term = document.getElementById('term-demo');
    if (!term) return;
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // The element carries its own scroll-gated reveal (not the shared
    // .reveal class), so these fallbacks must reveal it themselves.
    if (reduce || typeof IntersectionObserver !== 'function') {
      term.classList.add('in');
      return;
    }

    var data = JSON.parse(document.getElementById('term-data').textContent);
    var pre = term.querySelector('.term__body');
    var body = term.querySelector('.term__body code');

    function play() {
      // SSR already rendered the full transcript, so the box is exactly the
      // final height. Pin it before clearing — otherwise the replayed lines
      // would grow the box again and push the page around as they type.
      pre.style.height = pre.getBoundingClientRect().height + 'px';
      body.textContent = '';
      var caret = document.createElement('span');
      caret.className = 'term__caret';
      body.appendChild(caret);

      var i = 0;
      function nextLine() {
        if (i >= data.length) {
          // Show over; the typed content now matches the SSR layout, so the
          // box can follow its own content again (stays current on resize).
          pre.style.height = '';
          return;
        }
        var line = data[i++];
        var span = document.createElement('span');
        span.className = 'term__line term__line--' + line.kind;
        body.insertBefore(span, caret);
        if (line.kind === 'cmd') {
          var prompt = document.createElement('span');
          prompt.className = 'term__prompt';
          prompt.textContent = '› ';
          span.appendChild(prompt);
          var textNode = document.createTextNode('');
          span.appendChild(textNode);
          var j = 0;
          (function typeChar() {
            if (j < line.text.length) {
              textNode.textContent += line.text[j++];
              setTimeout(typeChar, 28 + Math.random() * 40);
            } else {
              span.appendChild(document.createTextNode('\n'));
              setTimeout(nextLine, 350);
            }
          })();
        } else {
          span.textContent = line.text + '\n';
          setTimeout(nextLine, line.kind === 'note' ? 900 : 140);
        }
      }
      nextLine();
    }

    // The terminal appears only when both of these hold: it is at least 25%
    // visible AND the visitor has actually scrolled away from the top of the
    // page. Visibility alone is not enough — the terminal sits at the bottom
    // of the hero, so on a tall viewport (or with the shorter Chinese copy)
    // part of it is on the first screen and would otherwise fade in and start
    // typing on load.
    //
    // Hiding has its own cost, so the decision is made in absolute units, not
    // as a share of the box (the transcript, and with it the box height, will
    // change): if the first screen already shows SHOW_ABOVE_REM or more of
    // the terminal, hiding it would leave a hole that reads as broken layout,
    // and the box belongs to the hero — it is revealed statically and never
    // replayed (clearing content the visitor already saw to re-type it is
    // worse than no motion). Below that, the hidden part reads as hero
    // whitespace and the replay waits for the scroll gate. rem keeps both
    // budgets on the page's own scale, so they survive transcript growth and
    // track the root font size across displays. If the page cannot scroll at
    // all, the SSR transcript simply stays.
    var rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
    var gatePx = 6 * rem;
    var SHOW_ABOVE_REM = 24;
    function exposurePx() {
      var rect = term.getBoundingClientRect();
      return Math.min(window.innerHeight, rect.bottom) - Math.max(0, rect.top);
    }
    var visible = false;
    var played = false;
    function startIfReady() {
      if (played || !visible || window.scrollY <= gatePx) return;
      played = true;
      io.disconnect();
      window.removeEventListener('scroll', startIfReady);
      window.removeEventListener('resize', promoteIfExposed);
      term.classList.add('in');
      play();
    }
    // A window move or resize can push the first screen past the exposure
    // threshold while the terminal is still gated; static is absorbing —
    // once shown there is no un-showing.
    function promoteIfExposed() {
      if (!played && exposurePx() >= SHOW_ABOVE_REM * rem) showStatically();
    }
    function showStatically() {
      played = true;
      io.disconnect();
      window.removeEventListener('scroll', startIfReady);
      window.removeEventListener('resize', promoteIfExposed);
      term.classList.add('in');
    }

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        visible = entry.isIntersecting;
        startIfReady();
      });
    }, { threshold: 0.25 });
    io.observe(term);
    window.addEventListener('scroll', startIfReady, { passive: true });
    window.addEventListener('resize', promoteIfExposed);
    if (exposurePx() >= SHOW_ABOVE_REM * rem) showStatically();
  })();
</script>
