---
import type { Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;

// The transcript mirrors real CLI output, verified line-by-line against
// the shipped CLI. A proposal is scripted as filled before implementation.
const fillNote = lang === 'zh' ? '# 填满必填章节之后' : '# after filling the required sections';
// example date for the proposal filename; static on purpose (this is a scripted
// demo, not a live capture — the date is decorative)
const demoDate = '2026-09-03';

type Line = { kind: 'cmd' | 'out' | 'ok' | 'note'; text: string };
const lines: Line[] = [
  { kind: 'cmd', text: 'adrkit record "Use SQLite for session storage" --raised-by human --decided-by human' },
  { kind: 'ok', text: 'created adr/implemented/1-use-sqlite-for-session-storage.md' },
  { kind: 'out', text: '' },
  { kind: 'out', text: 'fill in the shipped decision and validate it with:' },
  { kind: 'out', text: '  adrkit validate 1' },
  { kind: 'out', text: '' },
  { kind: 'out', text: 'tip: a record governing specific files can declare optional "paths: [src/**]" in the' },
  { kind: 'out', text: '  front matter; "adrkit relevant <path>" retrieves scoped records' },
  { kind: 'cmd', text: 'adrkit propose "Use Redis for session storage"' },
  { kind: 'out', text: `created adr/proposed/${demoDate}-use-redis-for-session-storage.md` },
  { kind: 'out', text: '' },
  { kind: 'out', text: 'When the work ships, record its outcome with' },
  { kind: 'out', text: '  adrkit implement "Use Redis for session storage" --raised-by human --decided-by human' },
  { kind: 'out', text: 'or reject the proposal with' },
  { kind: 'out', text: '  adrkit reject "Use Redis for session storage" --reason "<why>"' },
  { kind: 'out', text: '' },
  { kind: 'out', text: 'tip: a record governing specific files can declare optional "paths: [src/**]" in the' },
  { kind: 'out', text: '  front matter; "adrkit relevant <path>" retrieves scoped records' },
  { kind: 'note', text: fillNote },
  { kind: 'cmd', text: 'adrkit implement "Use Redis for session storage" --raised-by human --decided-by human' },
  { kind: 'ok', text: `implemented adr/proposed/${demoDate}-use-redis-for-session-storage.md as adr/implemented/2-use-redis-for-session-storage.md` },
];
const esc = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const transcriptHtml = lines
  .map((l) => {
    const inner = l.kind === 'cmd' ? `<span class="term__prompt">› </span>${esc(l.text)}` : esc(l.text);
    return `<span class="term__line term__line--${l.kind}">${inner}\n</span>`;
  })
  .join('');
---

<div class="term" id="term-demo">
  <div class="term__bar" aria-hidden="true">
    <span class="term__dot"></span><span class="term__dot"></span><span class="term__dot"></span>
    <span class="term__title">terminal</span>
  </div>
  <pre class="term__body" aria-label="adrkit demo transcript"><code set:html={transcriptHtml}></code></pre>
  <script type="application/json" id="term-data" set:html={JSON.stringify(lines)}></script>
</div>

<style is:global>
  /* Global on purpose: the replay builds its lines, prompt, and caret with
     JS, so those elements never carry Astro's scoping attribute — scoped
     rules would silently miss them (the caret has never rendered). Every
     selector is .term-prefixed and the component appears once per page. */
  .term {
    margin: 48px auto 0;
    max-width: 760px;
    text-align: left;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #0a0e14;
    overflow: hidden;
  }
  .term__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }
  .term__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .term__title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-30);
    letter-spacing: 0.08em;
  }
  /* selection-lock-demo: 演出容器锁选区，pre 解锁保留复制能力 */
  .term { user-select: none; -webkit-user-select: none; }
  .term__body {
    margin: 0;
    padding: 20px 22px;
    font-size: 13px;
    line-height: 1.75;
    white-space: pre-wrap;
    word-break: break-word;
    user-select: text;
    -webkit-user-select: text;
  }
  .term__line { display: inline; }
  .term__line--cmd { color: var(--fg); font-weight: 500; }
  .term__line--out { color: var(--fg-50); }
  .term__line--ok { color: var(--cyan); }
  .term__line--note { color: var(--fg-30); font-style: italic; }
  .term__prompt { color: var(--cyan); }
  .term__caret::after {
    content: "▋";
    color: var(--cyan);
    text-shadow: 0 0 10px rgba(34, 211, 238, 0.7);
    animation: term-blink 1s step-end infinite;
  }
  /* replay polish, all gated on .playing so the SSR transcript and
     reduced-motion users never animate: lines land with a soft rise and ok
     lines flash brighter for a beat. The three window dots stay untouched —
     they read as the macOS traffic-light buttons, and system controls must
     not flicker. */
  .term.playing .term__line { animation: term-line-in 0.18s ease-out both; }
  .term.playing .term__line--ok { animation: term-ok-in 0.6s ease-out both; }
  @keyframes term-line-in {
    from { opacity: 0; transform: translateY(2px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes term-ok-in {
    0% { opacity: 0; }
    30% { opacity: 1; color: #a5f3fc; }
    100% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .term.playing .term__line { animation: none; }
  }
  @keyframes term-blink { 50% { opacity: 0; } }
  /* The terminal does NOT use the shared .reveal class: the generic observer
     would fade it in while the hero is still on screen. It owns its reveal
     and its script decides when .in lands — on desktop only after the
     visitor scrolls it into view; on mobile the first screen exposes too
     much of the box to hide without a hole, so it is ordinary content.
     No-JS visitors keep the fully rendered transcript (the .js class gates
     these hidden initial states). */
  html.js .term {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }
  html.js .term.in { opacity: 1; transform: none; }
  /* mobile entrance: the terminal is ordinary content (shown immediately,
     no replay), but it still lands softly — a one-shot fade delayed so it
     follows the hero copy's rise, matching the site's cascade style */
  @media (max-width: 640px) {
    html.js .term.in { animation: term-mobile-in 0.45s ease-out 0.35s both; }
  }
  @keyframes term-mobile-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .term { opacity: 1; transform: none; transition: none; }
    html.js .term.in { animation: none; }
  }
  @media (max-width: 640px) {
    .term__body { font-size: 11.5px; }
  }
</style>

<script is:inline>
  // The one attention-grabbing motion on the page: on desktop the terminal
  // plays the real adrkit workflow when the visitor scrolls it into view.
  // SSR renders the full transcript, so no-JS / reduced-motion / mobile
  // users see everything; desktop JS clears and replays it with typing.
  (function () {
    var term = document.getElementById('term-demo');
    if (!term) return;
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // The element carries its own scroll-gated reveal (not the shared
    // .reveal class), so these fallbacks must reveal it themselves.
    if (reduce || typeof IntersectionObserver !== 'function') {
      term.classList.add('in');
      return;
    }

    var data = JSON.parse(document.getElementById('term-data').textContent);
    var pre = term.querySelector('.term__body');
    var body = term.querySelector('.term__body code');

    function play() {
      // SSR already rendered the full transcript, so the box is exactly the
      // final height. Pin it before clearing — otherwise the replayed lines
      // would grow the box again and push the page around as they type.
      pre.style.height = pre.getBoundingClientRect().height + 'px';
      body.textContent = '';
      term.classList.add('playing');
      var caret = document.createElement('span');
      caret.className = 'term__caret';
      body.appendChild(caret);

      var i = 0;
      function nextLine() {
        if (i >= data.length) {
          // Show over: drop the caret so the box settles into exactly the
          // SSR transcript — typed content matches it, and the box can
          // follow its own content again (stays current on resize).
          pre.style.height = '';
          caret.remove();
          term.classList.remove('playing');
          return;
        }
        var line = data[i++];
        var span = document.createElement('span');
        span.className = 'term__line term__line--' + line.kind;
        body.insertBefore(span, caret);
        if (line.kind === 'cmd') {
          var prompt = document.createElement('span');
          prompt.className = 'term__prompt';
          prompt.textContent = '› ';
          span.appendChild(prompt);
          var textNode = document.createTextNode('');
          span.appendChild(textNode);
          var j = 0;
          (function typeChar() {
            if (j < line.text.length) {
              // human cadence: usually one character per strike, sometimes
              // two in a quick burst, with uneven inter-key delays
              var step = Math.random() < 0.2 && j + 1 < line.text.length ? 2 : 1;
              textNode.textContent += line.text.slice(j, j + step);
              j += step;
              setTimeout(typeChar, 18 + Math.random() * 30);
            } else {
              span.appendChild(document.createTextNode('\n'));
              setTimeout(nextLine, 240);
            }
          })();
        } else {
          span.textContent = line.text + '\n';
          setTimeout(nextLine, line.kind === 'note' ? 500 : 90);
        }
      }
      nextLine();
    }

    // One fixed budget decides everything, in rem (the transcript, and with
    // it the box height, will change — a share of the box would drift):
    //  - Mobile (the shared 640px breakpoint): the first screen exposes too
    //    much of the box to hide without a hole, so it is ordinary content —
    //    shown immediately, no replay.
    //  - Desktop: the box stays out of the first screen entirely and is
    //    revealed, with the replay, once REVEAL_REM of it is visible after
    //    the visitor has scrolled. Any scroll is enough — there is no
    //    distance gate — so external displays where the box fits entirely
    //    still stay hidden until the first scroll.
    var mobile = matchMedia('(max-width: 640px)');
    var rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
    var REVEAL_REM = 12;
    var visible = false;
    var scrolled = false;
    var played = false;
    function visiblePx() {
      var rect = term.getBoundingClientRect();
      return Math.min(window.innerHeight, rect.bottom) - Math.max(0, rect.top);
    }
    function showStatically() {
      played = true;
      io.disconnect();
      term.classList.add('in');
    }
    function startIfReady() {
      if (played) return;
      if (mobile.matches) { showStatically(); return; }
      if (!visible || !scrolled || visiblePx() < REVEAL_REM * rem) return;
      played = true;
      io.disconnect();
      term.classList.add('in');
      play();
    }

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        visible = entry.isIntersecting;
        startIfReady();
      });
    }, { threshold: 0 });
    io.observe(term);
    window.addEventListener('scroll', function () {
      scrolled = true;
      startIfReady();
    }, { passive: true });
    if (mobile.addEventListener) {
      mobile.addEventListener('change', startIfReady);
    }
    if (mobile.matches) showStatically();
  })();
</script>
