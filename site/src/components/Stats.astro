---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);
const stats = [1, 2, 3, 4] as const;
---

<section class="stats">
  <div class="stats__inner reveal">
    {stats.map((n) => (
      <div class="stats__cell">
        {/* only the real count (7 workflow skills) plays the count-up; the
            other cells are descriptive numbers and stay static */}
        {n === 2 ? (
          <span class="stats__value" data-count={t(`stats.${n}.value` as const)}>{t(`stats.${n}.value` as const)}</span>
        ) : (
          <span class="stats__value">{t(`stats.${n}.value` as const)}</span>
        )}
        <span class="stats__label">{t(`stats.${n}.label` as const)}</span>
      </div>
    ))}
  </div>
</section>

<style>
  /* the stats band keeps its own top/bottom hairlines: it reads as a
     bounded strip across the page even though other sections space with
     plain whitespace */
  .stats { border-block: 1px solid var(--border); }

  .stats__inner {
    max-width: var(--inner);
    margin: 0 auto;
    padding: 40px 24px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  /* gap-as-divider: 1px columns drawn by the cell border, no wrappers */
  .stats__cell {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: center;
    text-align: center;
    padding: 14px 16px;
  }
  .stats__cell + .stats__cell { border-left: 1px solid var(--border); }
  .stats__value {
    font-family: var(--font-mono);
    font-size: clamp(38px, 5.5vw, 58px);
    font-weight: 800;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    color: var(--fg);
  }
  .stats__label {
    font-size: 12.5px;
    color: var(--fg-30);
  }
  @media (max-width: 640px) {
    .stats__inner { grid-template-columns: repeat(2, 1fr); row-gap: 8px; }
    /* on two columns the border only belongs on odd cells (1,3) */
    .stats__cell:nth-child(3) { border-left: none; }
  }
</style>

<script is:inline>
  // count-up on first view: SSR already renders the final value (no-JS /
  // reduced-motion users see it immediately); JS only re-plays from zero.
  (function () {
    var nums = Array.prototype.slice.call(document.querySelectorAll('.stats__value[data-count]'));
    if (!nums.length) return;
    if (
      matchMedia('(prefers-reduced-motion: reduce)').matches ||
      typeof IntersectionObserver !== 'function'
    ) {
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          io.unobserve(entry.target);
          var el = entry.target;
          var match = el.getAttribute('data-count').match(/^([0-9.]+)(.*)$/);
          if (!match) return;
          var target = parseFloat(match[1]);
          var suffix = match[2];
          var dur = 900;
          var start = null;
          function frame(t) {
            if (start === null) start = t;
            var p = Math.min(1, (t - start) / dur);
            var eased = 1 - Math.pow(1 - p, 3);
            el.textContent = Math.round(target * eased) + suffix;
            if (p < 1) requestAnimationFrame(frame);
          }
          requestAnimationFrame(frame);
        });
      },
      { threshold: 0.6 },
    );
    nums.forEach(function (el) { io.observe(el); });
  })();
</script>
