---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Two prompt levels, each a labeled snippet: the short one for most people,
// the full one when you want the agent to run the whole lifecycle.
const prompts = [
  { label: t('start.agent.short'), text: t('start.agent.prompt.short') },
  { label: t('start.agent.full'), text: t('start.agent.prompt.full') },
];
const steps = [
  { label: t('start.step1'), cmd: 'npm install -g adr-kit' },
  { label: t('start.step2'), cmd: 'adrkit init' },
  { label: t('start.step3'), cmd: 'adrkit propose "Use SQLite for session storage"' },
];
---

<section class="section start" id="get-started">
  <div class="section__inner">
    <div class="reveal">
      <p class="section__eyebrow">{t('start.eyebrow')}</p>
      <h2 class="section__title">{t('start.title')}</h2>
      <p class="section__lead">{t('start.lead')}</p>
    </div>
    <div class="start__grid reveal">
      <div class="start__card start__card--agent">
        <p class="start__label start__label--agent">{t('start.agent.label')}</p>
        {prompts.map((p) => (
          <div class="start__prompt">
            <p class="start__promptlabel">{p.label}</p>
            <div class="start__code">
              <button class="start__copy" data-copy={p.text} aria-label={t('hero.copy')}>
                <svg class="start__copy-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <svg class="start__copy-ic start__copy-ic--ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5"></path>
                </svg>
              </button>
              <code class="start__text">{p.text}</code>
            </div>
          </div>
        ))}
        <p class="start__footnote">{t('start.agents.footnote')}</p>
      </div>
      <div class="start__card start__card--human">
        <p class="start__label">{t('start.human.label')}</p>
        <div class="start__steps">
          {steps.map((s, i) => (
            <div class="start__step">
              <span class="start__num">{i + 1}</span>
              <div>
                <p class="start__steplabel">{s.label}</p>
                <code class="start__cmd">{s.cmd}</code>
              </div>
            </div>
          ))}
        </div>
        <p class="start__footnote">{t('start.node')}</p>
        <p class="start__footnote">{t('start.workflows')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .start__grid {
    margin-top: 44px;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 20px;
    align-items: stretch;
  }
  .start__card {
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    padding: 26px 26px 22px;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  /* both cards hover the same way: lift + brighten the border */
  .start__card:hover { transform: translateY(-3px); }
  .start__card--human:hover { border-color: var(--border-strong); }
  /* the agent path is the front door: cyan edge at rest, brighter on hover */
  .start__card--agent { border-color: #22d3ee55; }
  .start__card--agent:hover { border-color: #22d3eeb3; }
  .start__label {
    margin: 0 0 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-30);
  }
  .start__label--agent { color: var(--cyan); }

  .start__prompt + .start__prompt { margin-top: 20px; }
  /* a section-label for the snippet below it: mono, bold, with a small tag
     mark so it reads as a heading rather than faint caption text */
  .start__promptlabel {
    margin: 0 0 9px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg);
  }
  .start__promptlabel::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--cyan);
    opacity: 0.85;
  }
  /* a plain snippet box; the copy icon floats top-right */
  .start__code {
    position: relative;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    padding: 14px 48px 14px 18px;
  }
  .start__text {
    display: block;
    font-size: 13px;
    line-height: 1.7;
    color: var(--fg);
    word-break: break-word;
  }
  .start__copy {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 7px;
    border: 1px solid transparent;
    color: var(--fg-50);
    background: transparent;
    opacity: 0.55;
    cursor: pointer;
    transition: opacity 0.2s, color 0.15s, border-color 0.15s, background-color 0.15s;
  }
  .start__code:hover .start__copy,
  .start__card:hover .start__copy { opacity: 1; }
  .start__copy:hover { color: var(--fg); border-color: var(--border); background: var(--surface); opacity: 1; }
  .start__copy-ic { width: 14px; height: 14px; grid-area: 1 / 1; }
  .start__copy-ic--ok { visibility: hidden; color: var(--cyan); }
  .start__copy.copied .start__copy-ic { visibility: hidden; }
  .start__copy.copied .start__copy-ic--ok { visibility: visible; }

  .start__footnote {
    margin: 0;
    padding-top: 14px;
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--fg-50);
  }
  /* first footnote absorbs the leftover card height, so both cards end flush */
  .start__footnote:first-of-type { margin-top: auto; padding-top: 18px; }

  .start__steps { display: flex; flex-direction: column; }
  .start__step {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 13px 8px;
    margin: 0 -8px;
    border-radius: 8px;
    transition: background-color 0.15s;
  }
  .start__step:hover { background: var(--surface-hover); }
  .start__step + .start__step { border-top: 1px solid var(--border); }
  .start__num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--cyan);
    border: 1px solid var(--border);
    border-radius: 50%;
    width: 26px;
    height: 26px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    margin-top: 2px;
  }
  .start__steplabel { margin: 0 0 4px; font-size: 13.5px; color: var(--fg-70); }
  .start__cmd { font-size: 13px; color: var(--fg); word-break: break-all; }

  @media (max-width: 860px) {
    .start__grid { grid-template-columns: 1fr; }
  }
</style>
