---
import '../styles/global.css';
import { getLang, useTranslations, langPath, type Lang } from '../i18n/ui';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import pkg from '../../../package.json';

const lang = getLang(Astro.url);
const t = useTranslations(lang);

const site = 'https://luochang212.github.io';
const base = '/adr-kit';
const canonical = `${site}${base}${lang === 'zh' ? '/zh/' : '/'}`;
const enUrl = `${site}${base}/`;
const zhUrl = `${site}${base}/zh/`;
const ogImage = `${site}${base}/og.png`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'ADR Kit',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS, Linux, Windows',
      description: t('meta.description'),
      url: enUrl,
      downloadUrl: 'https://www.npmjs.com/package/adr-kit',
      softwareVersion: pkg.version,
      license: 'https://opensource.org/licenses/MIT',
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
      author: { '@type': 'Person', name: 'luochang212', url: 'https://github.com/luochang212' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [1, 2, 3].map((n) => ({
        '@type': 'Question',
        name: t(`faq.${n}.q` as const),
        acceptedAnswer: { '@type': 'Answer', text: t(`faq.${n}.a` as const) },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline data-language-redirect define:vars={{ basePath: import.meta.env.BASE_URL }}>
      (function () {
        var url = new URL(location.href);
        var root = basePath.replace(/\/$/, '') + '/';
        var path = url.pathname.replace(/\/index\.html$/, '/').replace(/\/$/, '');
        var isRoot = path === root.slice(0, -1);
        var isChinese = path === root + 'zh';
        if (!isRoot && !isChinese) return;

        // An explicit switch also works when storage is unavailable. A plain
        // Chinese URL stays Chinese; only the default entry detects language.
        var requested = url.searchParams.get('lang');
        var preferred = requested === 'en' || requested === 'zh' ? requested : null;
        if (preferred) {
          try { localStorage.setItem('adr-kit.language', preferred); } catch (_) {}
        } else {
          if (!isRoot) return;
          try { preferred = localStorage.getItem('adr-kit.language'); } catch (_) {}
          if (preferred !== 'en' && preferred !== 'zh') {
            // Chinese anywhere in the browser's list wins: a reader without
            // Chinese has no zh entry at all, so the list's order only ever
            // demotes a language the reader cannot use. Everyone else gets
            // English.
            preferred = 'en';
            var languages = navigator.languages && navigator.languages.length
              ? navigator.languages : [navigator.language];
            for (var language of languages) {
              if (/^zh(?:-|$)/i.test(language)) {
                preferred = 'zh';
                break;
              }
            }
          }
        }
        var target = root + (preferred === 'zh' ? 'zh/' : '');
        if (url.pathname !== target) {
          url.pathname = target;
          location.replace(url.href);
        }
      })();
    </script>
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{t('meta.title')}</title>
    <meta name="description" content={t('meta.description')} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t('meta.title')} />
    <meta property="og:description" content={t('meta.description')} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;650&family=JetBrains+Mono:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Nav lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      // scroll reveal: one-shot IntersectionObserver; content is fully
      // visible without JS (the .js class gates the hidden initial state)
      (function () {
        var els = document.querySelectorAll('.reveal');
        if (
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          typeof IntersectionObserver !== 'function'
        ) {
          els.forEach(function (e) { e.classList.add('in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('in');
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.05, rootMargin: '0px 0px -10% 0px' });
        els.forEach(function (e) { io.observe(e); });
      })();
    </script>
    <script is:inline>
      // declarative copy buttons, with execCommand fallback. Bound here, after
      // every component is parsed, so any [data-copy] button on the page works.
      (function () {
        document.querySelectorAll('[data-copy]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var text = btn.getAttribute('data-copy');
            function done() {
              btn.classList.add('copied');
              setTimeout(function () { btn.classList.remove('copied'); }, 1600);
            }
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(text).then(done, done);
            } else {
              var ta = document.createElement('textarea');
              ta.value = text;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              try { document.execCommand('copy'); } catch (e) {}
              document.body.removeChild(ta);
              done();
            }
          });
        });
      })();
    </script>
  </body>
</html>
