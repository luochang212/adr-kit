{
  "name": "adr-kit",
  "version": "0.5.0",
  "description": "Architecture Decision Records (ADRs) for AI coding assistants.",
  "type": "module",
  "license": "MIT",
  "author": "Chang Luo <luochang212@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luochang212/adr-kit.git"
  },
  "homepage": "https://github.com/luochang212/adr-kit#readme",
  "bugs": {
    "url": "https://github.com/luochang212/adr-kit/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
