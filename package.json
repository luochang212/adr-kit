{
  "name": "adr-kit",
  "version": "0.30.0",
  "description": "Architecture Decision Records (ADRs) for AI coding assistants.",
  "type": "module",
  "license": "MIT",
  "author": "Chang Luo <luochang212@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luochang212/adr-kit.git"
  },
  "homepage": "https://github.com/luochang212/adr-kit#readme",
  "bugs": {
    "url": "https://github.com/luochang212/adr-kit/issues"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "adrkit": "bin/adrkit.js"
  },
  "files": [
    "bin",
    "dist",
    "skills/adrkit-visualize/examples/decision-atlas.html",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node tools/build-workflow-skills.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:upstream": "node tools/check-grilling-upstream.mjs",
    "grilling:diff": "node tools/check-grilling-upstream.mjs --diff",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepublishOnly": "npm run build",
    "test:browser": "npm run build && node tools/build-decision-atlas.mjs && playwright test"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "^3.0.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "adr",
    "architecture-decision-records",
    "adrkit",
    "cli",
    "ai",
    "development"
  ]
}
